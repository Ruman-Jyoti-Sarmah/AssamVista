<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AssamVista — Soul of Assam, Land of the Brahmaputra</title>
    <meta
      name="description"
      content="AssamVista — official cultural portal of Assam. Explore 35 districts, Kaziranga, Majuli, tea gardens, Bihu festivals and the Brahmaputra."
    />
    <link rel="canonical" href="https://assamvista.example/" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content="AssamVista — Soul of Assam, Land of the Brahmaputra" />
    <meta
      property="og:description"
      content="Explore 35 districts, living heritage, tea gardens and the mighty Brahmaputra — the official cultural gateway of Assam."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/img/hero-brahmaputra.jpg" />
    <meta property="og:image:alt" content="Golden sunset over the Brahmaputra river in Assam" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/Logo/AssamVista-Logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Manrope:wght@200;300;400;500;600&family=Noto+Sans+Assamese:wght@300;400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Manrope:wght@300;400;500&family=Noto+Sans+Assamese:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.jsx"></script>
  </body>
</html>
